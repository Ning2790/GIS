# 生产环境配置清单（P3 部署卡）。复制为 .env.prod 并逐项替换，再按 docs/部署.md 部署。
# 注意：任何真实密钥都不进仓库（.env.prod 已在 .gitignore）；下面 <> 均为占位符。

# —— 环境（非 dev 会强制校验 JWT_SECRET 非默认值，并关闭交互式文档） ——
ENV=prod

# —— 必改：密钥与凭据 ——
# 生成随机密钥：openssl rand -hex 32
JWT_SECRET=<用 openssl rand -hex 32 生成后粘贴>
# 数据库强密码（compose 已参数化：同步改下面的 POSTGRES_PASSWORD 即可，或接外部托管 PG）
DATABASE_URL=postgresql+psycopg://qh:<强密码>@127.0.0.1:5432/qh_platform
REDIS_URL=redis://:<强密码>@127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=<替换，勿用 minioadmin>
MINIO_SECRET_KEY=<替换，勿用 minioadmin>

# —— 网关（Nginx，见 deploy/ 与 docker-compose.yml 的 nginx 服务）——
# 部署在受信 Nginx 之后必须为 true（限流按 X-Forwarded-For 识别来源 IP）。
# 服务端口直接对外暴露时绝不能开启（客户端可伪造该头绕过 IP 限流）。
TRUST_PROXY_HEADERS=true
NGINX_BIND_IP=0.0.0.0      # 网关对外提供服务
NGINX_HTTP_PORT=80         # 80 会 301 跳转至 HTTPS
NGINX_HTTPS_PORT=443
# 上游拓扑：后端也在容器里（Linux + profile full）→ 用 compose 服务名 api:8000。
# 后端跑在宿主机（Windows/macOS 本机验证）时改回 ./deploy/nginx/upstream.conf。
NGINX_UPSTREAM_CONF=./deploy/nginx/upstream.linux.conf

# —— 跨域：经网关同源部署时无跨域请求；前后端分域时填实际前端域名 ——
CORS_ORIGINS=["https://<你的域名>"]

# —— 大模型：默认 mock 仅用于演示，生产替换为真实服务（代码零改动） ——
AI_PROVIDER=openai
AI_BASE_URL=https://<兼容 OpenAI 协议的地址>/v1
AI_API_KEY=<密钥>
AI_MODEL=<模型名>

# —— 限流 / 排队 / 连接池（按承载实测调优，见 docs/压测报告.md） ——
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_REGISTER_PER_MINUTE=10
RATE_LIMIT_ORDER_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=15
QUEUE_MAX_VIEW=200
QUEUE_MAX_TRADE=50            # 取实测在途安全值（41 安全 / 67 起等连接超时），见压测报告
QUEUE_MAX_AUTH=20             # 认证类（仅登录 / 注册 / 改密，bcrypt 秒级占连接）
QUEUE_MAX_AI=30               # 接真实模型后必须重测
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=3          # 建立连接超时；须小于 DB_POOL_TIMEOUT，让「连不上」先暴露
SLOW_REQUEST_MS=500           # 慢请求告警阈值（毫秒；<=0 关闭）

# —— 气象数据源（gear 装备建议；默认 Open-Meteo 真实源，免密钥免费） ——
# 真实源逐城失败跳过，整批失败（断网）自动回退模拟源（快照 source 字段区分）。
WEATHER_PROVIDER=openmeteo

# —— 定时任务（气象采集 / 会话清理 / 订单超时 / 自动确认） ——
CELERY_BROKER_URL=redis://:<强密码>@127.0.0.1:6379/1

# —— 容器化部署（N15） ——
# 用法（compose 只读**项目根 .env**）：cp .env.prod.example .env.prod && make full-up ENV_FILE=.env.prod
# 也就是：.env.prod 通过 `ENV_FILE=` 指给 Makefile，compose 的 --env-file 便会读它；
# 不想用 ENV_FILE 时把它复制成根目录 .env 亦可（二者只选其一，别再散落到其它文件）。
# 下面三个凭据是 compose 里 postgres / redis / minio 与 api / worker 共用的一套值：
# 改这里即可（**注意**：POSTGRES_* 只在数据库卷首次初始化时生效，
# 已有数据卷的环境要改口令须进容器 ALTER USER）。
POSTGRES_USER=qh
POSTGRES_PASSWORD=<强密码，与 DATABASE_URL 一致>
POSTGRES_DB=qh_platform
REDIS_PASSWORD=<强密码，与 REDIS_URL 一致>
MINIO_ROOT_USER=<替换，勿用 minioadmin>
MINIO_ROOT_PASSWORD=<替换，勿用 minioadmin>

# —— 仅 Docker Desktop（Windows / macOS）需要：网关容器访问宿主机的显式 IPv4 ——
# （否则 host.docker.internal 会带一条不可达 IPv6，nginx 轮换地址导致偶发 502）
# Linux 生产**不要**取消注释（留空 = 用 host-gateway，本就是 IPv4）
# HOST_GATEWAY=192.168.65.254
