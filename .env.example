# 复制为 .env 后按需修改。.env 不提交到仓库。

# 运行环境：dev（默认，本地开发）。部署到服务器时改为 prod 等非 dev 值——
# 非 dev 环境启动时会强制校验 JWT_SECRET 不能是默认值。
ENV=dev

# Docker Desktop（Windows / macOS）：网关容器访问宿主机的映射地址。
# 留空/不设 = host-gateway（Linux 语义，正确且只有 IPv4）；Desktop 请显式填下方值，
# 否则容器内 host.docker.internal 会带一条**不可达的 IPv6**，nginx 轮换地址导致
# 偶发 502 且把上游摘除 10s（详因见 docs/部署.md）。
# HOST_GATEWAY=192.168.65.254

# 数据库连接串。
# 默认 SQLite —— 未安装 Docker 的机器也能把闭环跑通。
# 接入 docker-compose 的 PostgreSQL 时改为下面这行（注意用 127.0.0.1 而不是 localhost：
# Docker 端口只发布在 IPv4，Windows 下 localhost 会先解析到 ::1 造成连接挂起）：
# DATABASE_URL=postgresql+psycopg://qh:dev@127.0.0.1:5432/qh_platform
DATABASE_URL=sqlite:///./dev.db

# JWT 签名密钥。生产环境务必替换为随机值（至少 32 字节）。
JWT_SECRET=dev-only-secret-change-me-in-production-32b+

# 「记住我」未勾选时的刷新令牌有效期（小时；勾选时为 30 天，需求 4.2 设备绑定）：
# REFRESH_TOKEN_SHORT_EXPIRE_HOURS=12

# 允许跨域的前端地址（JSON 数组格式）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# Redis（交易预扣闸门 / 接口限流；留空 = 不启用，相关能力自动降级）。
# 容器带密码（见 docker-compose.yml），本机直连用 127.0.0.1：
# REDIS_URL=redis://:dev@127.0.0.1:6379/0

# 接口限流（固定窗口计数，每分钟；Redis 不可用时自动放行）。
# 默认值如下，按需收紧 / 放宽；<= 0 或 RATE_LIMIT_ENABLED=false 表示关闭：
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=20       # 登录（按 IP）
# RATE_LIMIT_REGISTER_PER_MINUTE=10    # 注册（按 IP）
# RATE_LIMIT_ORDER_PER_MINUTE=60       # 下单 / 结算（按用户）
# RATE_LIMIT_AI_PER_MINUTE=15          # AI 问答（按用户）

# 单机排队闸门（按类别限制在途请求数；超限返回 503「排队中」，交易类独立配额优先放行）。
# 0 或 QUEUE_ENABLED=false 表示不限；数值以压测结论为准（见 docs/压测报告.md）：
# QUEUE_ENABLED=true
# QUEUE_MAX_VIEW=200                   # 普通查看类（毫秒级读，实测不压垮连接池）
# QUEUE_MAX_TRADE=50                   # 交易类（下单 / 结算 / 支付）：≤ 连接池可服务并发
# QUEUE_MAX_AUTH=20                    # 认证类（登录 / 注册 / 刷新）：bcrypt 秒级占连接，单独收紧
# QUEUE_MAX_AI=30                      # AI 类（模型调用慢，容量最小；接真实模型后需重测）

# 热点读缓存（景点 / 商品列表；写路径 bump 失效）：
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=60

# 数据库连接池（与 40 线程池匹配；多实例部署时按实例数收紧，注意 PG max_connections）：
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=5
# 建立连接超时（秒，PostgreSQL）：库不可达时快速失败，须小于 DB_POOL_TIMEOUT；
# 0/负值等于不超时（会挂到分钟级），libpq 会把 <2 的值钳到 2 秒：
# DB_CONNECT_TIMEOUT=3
# 语句超时（毫秒，PostgreSQL；0 = 不设）：慢查询会被掐断并计 db_statement_timeout_total，
# 避免一条慢 SQL 长期占住连接与工作线程（默认 10000 = 10 秒）：
# DB_STATEMENT_TIMEOUT_MS=10000

# 向量检索（N12）：嵌入是独立配置（与聊天用的 AI_PROVIDER 无关），默认 mock 确定性嵌入
# （无外网/密钥，演示可复现）。接真实嵌入模型时改下面这些项，并重跑 seed_knowledge.py 重算向量。
# EMBEDDING_PROVIDER=mock
# EMBEDDING_MODEL=          # provider=openai 时必填，如 Qwen3-Embedding-0.6B
# EMBEDDING_BASE_URL=       # 如 http://127.0.0.1:8001/v1
# EMBEDDING_API_KEY=
# RAG_TOP_K=3               # 检索返回条数上限
# RAG_MIN_SCORE=0.24        # 低于该余弦相似度不算向量命中（关键词路径独立生效）

# 支付网关（N13）：mock = 占位实现（无支付链接，回调由管理员在控制台模拟）。
# 接支付宝 / 微信需实现协议并在此切换（步骤见 docs/部署.md「接真实支付网关」）。
# PAYMENT_GATEWAY=mock

# 日志与请求追踪（N8）：非 dev 环境输出 JSON 单行日志，并按 X-Request-ID 串联；
# 请求耗时超过该毫秒数记 warning（<= 0 关闭慢请求日志）：
# SLOW_REQUEST_MS=500

# MinIO 对象存储（P2 资质文件上传；留空 ENDPOINT = 上传接口 503，自动降级）。
# docker-compose 默认凭据与地址如下：
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=qh-files
# FILE_MAX_MB=10
# FILE_ALLOWED_TYPES=["image/jpeg","image/png","image/webp","application/pdf"]
# 数据保留期（维护卡 P0+P1；0 = 关闭该类清理，默认值即推荐值，见 docs/数据增长与归档方案.md）
# 每天 04:00 由 Celery Beat 清理；也可手动 `make purge-data`（默认演练，ARGS=--yes 执行）
# RETENTION_AI_MESSAGES_DAYS=365
# RETENTION_CS_MESSAGES_DAYS=365
# RETENTION_PRODUCT_VIEWS_DAYS=180
# RETENTION_AUDIT_LOGS_DAYS=365
# RETENTION_WEATHER_SNAPSHOTS_DAYS=30
# RETENTION_INVENTORY_DAYS=365
# RETENTION_NOTIFICATIONS_DAYS=365
# RETENTION_BATCH_SIZE=1000
# RETENTION_MAX_PER_RUN=50000

# 图片处理（需求 4.1）：上传时压缩 + 生成缩略图；0 = 关闭（只影响新上传的文件）
# IMAGE_MAX_EDGE=1600
# IMAGE_JPEG_QUALITY=82
# IMAGE_THUMBNAIL_EDGE=400

# 部署在受信反向代理（Nginx 网关，见 deploy/ 与 docs/部署.md）之后时设为 true：
# 接口限流按 X-Forwarded-For 识别来源 IP。端口直接对外暴露时不要开启。
# TRUST_PROXY_HEADERS=true

# 网关端口覆盖（docker-compose 的 nginx 服务；生产示例见 .env.prod.example）：
# NGINX_BIND_IP=127.0.0.1
# NGINX_HTTP_PORT=8080
# NGINX_HTTPS_PORT=8443

# 气象数据源（gear 装备建议，需求 2.2）：openmeteo = Open-Meteo 真实源（免密钥免费）；
# mock = 确定性模拟源。真实源逐城失败跳过，整批失败（断网）自动回退模拟源
# （快照 source 字段区分：openmeteo / mock）：
# WEATHER_PROVIDER=openmeteo
# WEATHER_TIMEOUT_SECONDS=10
# WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# 待支付订单超时自动取消（Celery Beat 每分钟扫描；演示可临时调小，如 1）：
# ORDER_EXPIRE_MINUTES=30

# 确认收货自动兜底（N3）：签收后该天数内买家未确认则自动确认；
# 若商户一直未标记签收，则发货后 fallback 天兜底自动确认：
# ORDER_AUTO_CONFIRM_DAYS=7
# ORDER_AUTO_CONFIRM_FALLBACK_DAYS=15

# 售后有效期（N4）：订单「已完成」后该天数内可申请售后（已支付 / 已发货阶段不限时）：
# AFTER_SALE_WINDOW_DAYS=15

# Celery broker（定时采集等后台任务；留空 = 不启动 worker，手动脚本可用）。
# CELERY_BROKER_URL=redis://:dev@127.0.0.1:6379/1

# 大模型调用（统一入口 app/core/llm.py）。默认 mock：无需密钥即可跑通全链路（本地与 CI 都靠它）。
# 接入云端（兼容 OpenAI 协议）时启用下面几项，代码零改动：
# AI_PROVIDER=openai
# AI_BASE_URL=https://<地址>/v1
# AI_API_KEY=<密钥>
# AI_MODEL=<模型名>
AI_PROVIDER=mock
